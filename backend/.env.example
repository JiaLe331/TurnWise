GOOGLE_CLOUD_PROJECT=demo-turnwise
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Vision replay (Task C). Same token on API and gateway; the API refuses /observations without it.
TURNWISE_GATEWAY_TOKEN=change-me-local-only
# Optional: restrict the token to one camera.
TURNWISE_GATEWAY_CAMERA=cctv-01
TURNWISE_API_URL=http://127.0.0.1:8000
TURNWISE_DETECTOR_MODEL=rfdetr-nano
# mps on Apple silicon, else cpu. Auto-selected when unset.
TURNWISE_DETECTOR_DEVICE=
