# Copy to .env (gitignored) at the repository root. Read by the API, the camera gateway and
# deploy/docker-compose.yml. Real environment variables take precedence.

# Storage: memory (resets on restart) or firestore
TURNWISE_STORAGE=memory
GOOGLE_CLOUD_PROJECT=your-firebase-project-id
# Service account key JSON on one line, in single quotes
# (Firebase console > Project settings > Service accounts > Generate new private key).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local emulator instead of a real project: set this and leave the key empty.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Shared secret between the API and the on-site camera gateway; long and random on a server.
TURNWISE_GATEWAY_TOKEN=change-me
# Optional: restrict the token to one camera.
# TURNWISE_GATEWAY_CAMERA=cctv-01
TURNWISE_API_URL=http://127.0.0.1:8000
TURNWISE_DETECTOR_MODEL=rfdetr-nano
# mps on Apple silicon, else cpu. Auto-selected when empty.
TURNWISE_DETECTOR_DEVICE=

# Server only: a domain or <ip-with-dashes>.sslip.io for Caddy HTTPS, or :80 for plain HTTP.
SITE_ADDRESS=:80
